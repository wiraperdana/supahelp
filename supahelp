/**
 * Read SQL query from a file
 * @param {string} filePath - Path to the SQL file
 * @returns {Promise<string>} - The SQL query string
 */
async function readQueryFromFile(filePath) {
  try {
    // Check if the file exists
    if (!fs.existsSync(filePath)) {
      console.error(`${colors.red}Error: File not found: ${filePath}${colors.reset}`);
      process.exit(1);
    }

    // Read the file
    const query = fs.readFileSync(filePath, 'utf8');

    if (!query || query.trim() === '') {
      console.error(`${colors.red}Error: File is empty: ${filePath}${colors.reset}`);
      process.exit(1);
    }

    return query;
  } catch (err) {
    console.error(`${colors.red}Error reading file: ${err.message}${colors.reset}`);
    process.exit(1);
  }
}

/**
 * Execute a SQL query and display the results
 * @param {string} queryStringOrFile - SQL query string or file path
 * @param {Object} options - Additional options
 * @param {boolean} options.csv - Whether to output in CSV format
 * @param {boolean} options.fromFile - Whether the query is from a file
 */
async function executeQuery(queryStringOrFile, options = {}) {
  let queryString;

  if (options.fromFile) {
    // Read query from file
    queryString = await readQueryFromFile(queryStringOrFile);
    console.log(`${colors.blue}Loaded query from file: ${queryStringOrFile}${colors.reset}`);
  } else {
    // Use the provided query string
    queryString = queryStringOrFile;
  }

  if (!queryString) {
    console.error(`${colors.red}Error: No SQL query specified${colors.reset}`);
    console.log(`Usage: supahelp query "SELECT * FROM table_name"`);
    console.log(`   or: supahelp query query.sql`);
    process.exit(1);
  }

  let client = null;

  try {
    // Connect to the database
    client = await pool.connect();
    console.log(`${colors.green}Connected to Supabase database${colors.reset}`);

    // Execute the query
    console.log(`${colors.blue}Executing query...${colors.reset}`);
    const startTime = Date.now();
    const result = await client.query(queryString);
    const endTime = Date.now();
    const executionTime = (endTime - startTime) / 1000;

    // Display the results
    if (result.rows.length === 0) {
      console.log(`${colors.yellow}Query returned no rows${colors.reset}`);
      console.log(`${colors.blue}Execution time: ${executionTime.toFixed(2)} seconds${colors.reset}`);
      return;
    }

    console.log(`${colors.green}Query returned ${result.rows.length} rows${colors.reset}`);
    console.log(`${colors.blue}Execution time: ${executionTime.toFixed(2)} seconds${colors.reset}`);

    // Get column names
    const columns = Object.keys(result.rows[0]);

    if (options.csv) {
      // Output in CSV format
      console.log(columns.join(','));
      result.rows.forEach(row => {
        const values = columns.map(col => {
          const value = row[col];
          if (value === null) return '';
          if (typeof value === 'string') return `"${value.replace(/"/g, '""')}"`;
          if (typeof value === 'object' && value instanceof Date) {
            return `"${value.toISOString()}"`;
          }
          if (typeof value === 'object') {
            return `"${JSON.stringify(value).replace(/"/g, '""')}"`;
          }
          return value;
        });
        console.log(values.join(','));
      });
    } else {
      // Calculate column widths for pretty printing
      const columnWidths = {};
      columns.forEach(col => {
        // Start with the column name length
        columnWidths[col] = col.length;

        // Check each row for this column
        result.rows.forEach(row => {
          const value = row[col];
          const valueStr = value === null ? 'NULL' :
                          (typeof value === 'object' ? JSON.stringify(value) : String(value));
          columnWidths[col] = Math.max(columnWidths[col], valueStr.length);
        });

        // Cap the width at 50 characters
        columnWidths[col] = Math.min(columnWidths[col], 50);
      });

      // Print header
      const header = columns.map(col => col.padEnd(columnWidths[col])).join(' | ');
      const separator = columns.map(col => '-'.repeat(columnWidths[col])).join('-+-');
      console.log(`\n${colors.cyan}${header}${colors.reset}`);
      console.log(`${colors.cyan}${separator}${colors.reset}`);

      // Print rows
      result.rows.forEach(row => {
        const rowStr = columns.map(col => {
          const value = row[col];
          let valueStr = value === null ? 'NULL' :
                        (typeof value === 'object' ? JSON.stringify(value) : String(value));

          // Truncate long values
          if (valueStr.length > columnWidths[col]) {
            valueStr = valueStr.substring(0, columnWidths[col] - 3) + '...';
          }

          return valueStr.padEnd(columnWidths[col]);
        }).join(' | ');
        console.log(rowStr);
      });
      console.log('');
    }

  } catch (err) {
    console.error(`${colors.red}Error executing query: ${err.message}${colors.reset}`);

    // Check if it's a connection error
    if (err.code === 'ECONNREFUSED' || err.code === '28P01' || err.code === '3D000' || err.message.includes('connect')) {
      console.error(`${colors.yellow}Database connection error. Please check your connection settings.${colors.reset}`);
      console.error(`${colors.yellow}To set the connection string, use the SUPABASE_CONNECTION_STRING environment variable:${colors.reset}`);
      console.error(`${colors.yellow}export SUPABASE_CONNECTION_STRING='postgresql://postgres:password@your-supabase-host:5432/postgres'${colors.reset}`);
      console.error(`${colors.yellow}Make sure your database is running and accessible.${colors.reset}`);
    }

    process.exit(1);
  } finally {
    if (client) {
      client.release();
    }

    await pool.end();
  }
}

/**
 * Show database connection status and information
 */
async function showStatus() {
  // Get masked connection string for display
  const maskedConnString = maskConnectionString(connectionString);

  console.log(`
${colors.bright}Supabase Connection Status${colors.reset}

${colors.bright}Connection String:${colors.reset}
  ${maskedConnString}
`);

  let client = null;

  try {
    // Connect to the database
    client = await pool.connect();
    console.log(`${colors.green}✓ Connected to Supabase database${colors.reset}`);

    // Get database information
    const versionResult = await client.query('SELECT version()');
    const dbVersion = versionResult.rows[0].version;

    // Get database size
    const sizeResult = await client.query(`
      SELECT pg_size_pretty(pg_database_size(current_database())) as size
    `);
    const dbSize = sizeResult.rows[0].size;

    // Get table count
    const tableCountResult = await client.query(`
      SELECT COUNT(*) as count
      FROM information_schema.tables
      WHERE table_schema = 'public'
      AND table_type = 'BASE TABLE'
    `);
    const tableCount = tableCountResult.rows[0].count;

    // Get top 5 tables by size
    const tablesResult = await client.query(`
      SELECT
        table_name,
        pg_size_pretty(pg_total_relation_size(quote_ident(table_name))) as size,
        pg_total_relation_size(quote_ident(table_name)) as size_bytes
      FROM information_schema.tables
      WHERE table_schema = 'public'
      AND table_type = 'BASE TABLE'
      ORDER BY pg_total_relation_size(quote_ident(table_name)) DESC
      LIMIT 5
    `);

    console.log(`
${colors.bright}Database Information:${colors.reset}
  ${colors.blue}Version:${colors.reset} ${dbVersion.split(',')[0]}
  ${colors.blue}Database Size:${colors.reset} ${dbSize}
  ${colors.blue}Table Count:${colors.reset} ${tableCount}
    `);

    if (tablesResult.rows.length > 0) {
      console.log(`${colors.bright}Top Tables by Size:${colors.reset}`);
      tablesResult.rows.forEach(row => {
        console.log(`  ${colors.blue}${row.table_name}:${colors.reset} ${row.size}`);
      });
    }

  } catch (err) {
    console.error(`${colors.red}Error connecting to database: ${err.message}${colors.reset}`);

    // Check if it's a connection error
    if (err.code === 'ECONNREFUSED' || err.code === '28P01' || err.code === '3D000' || err.message.includes('connect')) {
      console.error(`${colors.yellow}Database connection error. Please check your connection settings.${colors.reset}`);
      console.error(`${colors.yellow}To set the connection string, use the SUPABASE_CONNECTION_STRING environment variable:${colors.reset}`);
      console.error(`${colors.yellow}export SUPABASE_CONNECTION_STRING='postgresql://postgres:password@your-supabase-host:5432/postgres'${colors.reset}`);
      console.error(`${colors.yellow}Make sure your database is running and accessible.${colors.reset}`);
    }

    process.exit(1);
  } finally {
    if (client) {
      client.release();
    }

    await pool.end();
  }
}

/**
 * Main function
 */
async function main() {
  const args = process.argv.slice(2);
  const command = args[0];

  if (!command || command === 'help' || command === '--help' || command === '-h') {
    showHelp();
    process.exit(0);
  }

  switch (command.toLowerCase()) {
    case 'import':
      await importSQL(args[1]);
      break;
    case 'dump': {
      // Check for flags
      const schemaOnly = args.includes('--schema-only');
      const tableIndex = args.indexOf('--table');
      const hasTableFlag = tableIndex !== -1 && tableIndex + 1 < args.length;
      const table = hasTableFlag ? args[tableIndex + 1] : null;

      // Create a filtered args array without the flags and their values
      let filteredArgs = [...args];
      if (schemaOnly) {
        filteredArgs = filteredArgs.filter(arg => arg !== '--schema-only');
      }
      if (hasTableFlag) {
        filteredArgs = filteredArgs.filter((_, index) =>
          index !== tableIndex && index !== tableIndex + 1
        );
      }

      // Get the output file (first argument after command and flags)
      const outputFile = filteredArgs.length > 1 ? filteredArgs[1] : null;

      await dumpDatabase(outputFile, { schemaOnly, table });
      break;
    }
    case 'query': {
      // Check for --csv flag
      const csv = args.includes('--csv');
      // Remove the flag from args if present to get the query
      const queryArgs = args.filter(arg => arg !== '--csv').slice(1);

      if (queryArgs.length === 0) {
        console.error(`${colors.red}Error: No SQL query or file specified${colors.reset}`);
        console.log(`Usage: supahelp query "SELECT * FROM table_name"`);
        console.log(`   or: supahelp query query.sql`);
        process.exit(1);
      }

      // Check if the first argument is a file path
      const firstArg = queryArgs[0];
      const isFilePath = firstArg.endsWith('.sql') && queryArgs.length === 1;

      if (isFilePath) {
        // Execute query from file
        await executeQuery(firstArg, { csv, fromFile: true });
      } else {
        // Execute query from command line
        const queryString = queryArgs.join(' ');
        await executeQuery(queryString, { csv, fromFile: false });
      }
      break;
    }
    case 'status':
      await showStatus();
      break;
    default:
      console.error(`${colors.red}Unknown command: ${command}${colors.reset}`);
      showHelp();
      process.exit(1);
  }
}

// Run the main function
main().catch(err => {
  console.error(`${colors.red}Unhandled error: ${err.message}${colors.reset}`);

  // Check if it's a connection error
  if (err.code === 'ECONNREFUSED' || err.code === '28P01' || err.code === '3D000' || err.message.includes('connect')) {
    console.error(`${colors.yellow}Database connection error. Please check your connection settings.${colors.reset}`);
    console.error(`${colors.yellow}To set the connection string, use the SUPABASE_CONNECTION_STRING environment variable:${colors.reset}`);
    console.error(`${colors.yellow}export SUPABASE_CONNECTION_STRING='postgresql://postgres:password@your-supabase-host:5432/postgres'${colors.reset}`);
    console.error(`${colors.yellow}Make sure your database is running and accessible.${colors.reset}`);
  }

  process.exit(1);
});

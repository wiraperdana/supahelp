#!/usr/bin/env node

const fs = require('fs');
const path = require('path');
const { Pool } = require('pg');
const readline = require('readline');

// Connection string for Supabase from environment variable
// Default connection string is used if SUPABASE_CONNECTION_STRING is not set
const connectionString = process.env.SUPABASE_CONNECTION_STRING || 'postgresql://postgres:password@localhost:5432/postgres';

// ANSI color codes for terminal output
const colors = {
  reset: '\x1b[0m',
  bright: '\x1b[1m',
  dim: '\x1b[2m',
  red: '\x1b[31m',
  green: '\x1b[32m',
  yellow: '\x1b[33m',
  blue: '\x1b[34m',
  magenta: '\x1b[35m',
  cyan: '\x1b[36m',
};

// Create a new pool
const pool = new Pool({
  connectionString: connectionString,
});

// Handle pool connection errors
pool.on('error', (err) => {
  console.error(`${colors.red}Database connection error: ${err.message}${colors.reset}`);
  console.error(`${colors.yellow}Please check your database connection settings.${colors.reset}`);
  console.error(`${colors.yellow}To set the connection string, use the SUPABASE_CONNECTION_STRING environment variable:${colors.reset}`);
  console.error(`${colors.yellow}export SUPABASE_CONNECTION_STRING='postgresql://postgres:password@your-supabase-host:5432/postgres'${colors.reset}`);
  console.error(`${colors.yellow}Make sure your database is running and accessible.${colors.reset}`);
  process.exit(1);
});

/**
 * Import SQL file to Supabase
 * @param {string} filePath - Path to SQL file
 */
async function importSQL(filePath) {
  if (!filePath) {
    console.error(`${colors.red}Error: No SQL file specified${colors.reset}`);
    console.log(`Usage: supahelp import <file.sql>`);
    process.exit(1);
  }

  if (!fs.existsSync(filePath)) {
    console.error(`${colors.red}Error: File '${filePath}' not found${colors.reset}`);
    process.exit(1);
  }

  let client = null;

  try {
    // Connect to the database
    client = await pool.connect();
    console.log(`${colors.green}Connected to Supabase database${colors.reset}`);

    // Read the SQL file
    const sqlContent = fs.readFileSync(filePath, 'utf8');

    // Format file size in appropriate units
    const fileSizeInBytes = sqlContent.length;
    let fileSizeStr;
    if (fileSizeInBytes < 1024) {
      fileSizeStr = `${fileSizeInBytes} bytes`;
    } else if (fileSizeInBytes < 1024 * 1024) {
      fileSizeStr = `${(fileSizeInBytes / 1024).toFixed(2)} KB`;
    } else {
      fileSizeStr = `${(fileSizeInBytes / (1024 * 1024)).toFixed(2)} MB`;
    }

    console.log(`${colors.blue}Read ${fileSizeStr} from ${filePath}${colors.reset}`);

    // Check if the file contains SQL statements
    const insertCount = (sqlContent.match(/INSERT INTO/gi) || []).length;
    const deleteCount = (sqlContent.match(/DELETE FROM/gi) || []).length;
    const truncateCount = (sqlContent.match(/TRUNCATE TABLE/gi) || []).length;
    const updateCount = (sqlContent.match(/UPDATE /gi) || []).length;
    const createCount = (sqlContent.match(/CREATE TABLE/gi) || []).length;
    const dropCount = (sqlContent.match(/DROP TABLE/gi) || []).length;
    const alterCount = (sqlContent.match(/ALTER TABLE/gi) || []).length;

    const totalStatements = insertCount + deleteCount + truncateCount + updateCount + createCount + dropCount + alterCount;

    console.log(`${colors.blue}Found approximately:${colors.reset}`);
    if (insertCount > 0) console.log(`${colors.blue}- ${insertCount} INSERT statements${colors.reset}`);
    if (deleteCount > 0) console.log(`${colors.blue}- ${deleteCount} DELETE statements${colors.reset}`);
    if (truncateCount > 0) console.log(`${colors.blue}- ${truncateCount} TRUNCATE statements${colors.reset}`);
    if (updateCount > 0) console.log(`${colors.blue}- ${updateCount} UPDATE statements${colors.reset}`);
    if (createCount > 0) console.log(`${colors.blue}- ${createCount} CREATE TABLE statements${colors.reset}`);
    if (dropCount > 0) console.log(`${colors.blue}- ${dropCount} DROP TABLE statements${colors.reset}`);
    if (alterCount > 0) console.log(`${colors.blue}- ${alterCount} ALTER TABLE statements${colors.reset}`);

    // Ask for confirmation before proceeding
    if (totalStatements > 0) {
      const answer = await askQuestion(`${colors.yellow}Are you sure you want to execute these statements? (y/n): ${colors.reset}`);
      if (answer.toLowerCase() !== 'y' && answer.toLowerCase() !== 'yes') {
        console.log(`${colors.yellow}Import cancelled${colors.reset}`);
        process.exit(0);
      }
    } else {
      console.log(`${colors.yellow}No SQL statements found in the file.${colors.reset}`);
      const answer = await askQuestion(`${colors.yellow}Continue anyway? (y/n): ${colors.reset}`);
      if (answer.toLowerCase() !== 'y' && answer.toLowerCase() !== 'yes') {
        console.log(`${colors.yellow}Import cancelled${colors.reset}`);
        process.exit(0);
      }
    }

    // Execute the SQL statements
    console.log(`${colors.yellow}Importing data...${colors.reset}`);

    // Begin transaction
    await client.query('BEGIN');

    // Process the SQL file directly
    console.log(`${colors.yellow}Executing SQL file directly...${colors.reset}`);

    try {
      // Execute the entire SQL file as a single query
      await client.query(sqlContent);
      console.log(`${colors.green}SQL file executed successfully${colors.reset}`);

      // Commit transaction
      await client.query('COMMIT');

      // Count executed statements by type
      const insertCount = (sqlContent.match(/INSERT INTO/gi) || []).length;
      const deleteCount = (sqlContent.match(/DELETE FROM/gi) || []).length;
      const truncateCount = (sqlContent.match(/TRUNCATE TABLE/gi) || []).length;
      const updateCount = (sqlContent.match(/UPDATE /gi) || []).length;
      const createCount = (sqlContent.match(/CREATE TABLE/gi) || []).length;
      const dropCount = (sqlContent.match(/DROP TABLE/gi) || []).length;
      const alterCount = (sqlContent.match(/ALTER TABLE/gi) || []).length;

      // Show detailed success counts
      console.log(`${colors.green}Successful statements by type:${colors.reset}`);
      if (insertCount > 0) console.log(`${colors.green}- INSERT: ${insertCount}${colors.reset}`);
      if (deleteCount > 0) console.log(`${colors.green}- DELETE: ${deleteCount}${colors.reset}`);
      if (truncateCount > 0) console.log(`${colors.green}- TRUNCATE: ${truncateCount}${colors.reset}`);
      if (updateCount > 0) console.log(`${colors.green}- UPDATE: ${updateCount}${colors.reset}`);
      if (createCount > 0) console.log(`${colors.green}- CREATE TABLE: ${createCount}${colors.reset}`);
      if (dropCount > 0) console.log(`${colors.green}- DROP TABLE: ${dropCount}${colors.reset}`);
      if (alterCount > 0) console.log(`${colors.green}- ALTER TABLE: ${alterCount}${colors.reset}`);

      return;
    } catch (err) {
      console.error(`${colors.red}Error executing SQL file directly: ${err.message}${colors.reset}`);
      console.log(`${colors.yellow}Falling back to statement-by-statement execution...${colors.reset}`);

      // Rollback the failed transaction
      await client.query('ROLLBACK');

      // Begin a new transaction
      await client.query('BEGIN');
    }

    // Split the SQL file into individual statements
    // This is a more robust approach to split SQL statements
    // It handles semicolons inside quotes, comments, and dollar-quoted strings
    const statements = [];
    let currentStatement = '';
    let inSingleQuote = false;
    let inDoubleQuote = false;
    let inComment = false;
    let inDollarQuote = false;
    let dollarTag = '';

    // Process the SQL file character by character
    for (let i = 0; i < sqlContent.length; i++) {
      const char = sqlContent[i];
      const nextChar = sqlContent[i + 1] || '';

      // Handle comments
      if (!inSingleQuote && !inDoubleQuote && !inDollarQuote && char === '-' && nextChar === '-') {
        inComment = true;
        currentStatement += char;
        continue;
      }

      // End of line terminates single-line comments
      if (inComment && (char === '\n' || char === '\r')) {
        inComment = false;
        currentStatement += char;
        continue;
      }

      // Skip processing if in a comment
      if (inComment) {
        currentStatement += char;
        continue;
      }

      // Handle dollar-quoted strings (e.g., $$ or $tag$)
      if (!inSingleQuote && !inDoubleQuote && char === '$') {
        // Check if this is the start of a dollar quote
        if (!inDollarQuote) {
          // Look ahead to find the tag (if any)
          let tag = '';
          let j = i + 1;
          while (j < sqlContent.length && sqlContent[j] !== '$' && /[a-zA-Z0-9_]/.test(sqlContent[j])) {
            tag += sqlContent[j];
            j++;
          }

          // If we found a closing $ after the tag, this is a dollar quote
          if (j < sqlContent.length && sqlContent[j] === '$') {
            inDollarQuote = true;
            dollarTag = tag;
            currentStatement += char; // Add the opening $
            continue;
          }
        } else {
          // Check if this is the end of the current dollar quote
          let isClosing = true;
          let j = i + 1;

          // Check if the tag matches
          for (let k = 0; k < dollarTag.length; k++) {
            if (j + k >= sqlContent.length || sqlContent[j + k] !== dollarTag[k]) {
              isClosing = false;
              break;
            }
          }

          // Check for the closing $
          if (isClosing && j + dollarTag.length < sqlContent.length && sqlContent[j + dollarTag.length] === '$') {
            inDollarQuote = false;
            dollarTag = '';
          }
        }
      }

      // Handle quotes
      if (!inDollarQuote && !inComment) {
        if (char === "'" && !inDoubleQuote) {
          // Toggle single quote state, but only if not escaped
          if (i > 0 && sqlContent[i - 1] !== '\\') {
            inSingleQuote = !inSingleQuote;
          }
        } else if (char === '"' && !inSingleQuote) {
          // Toggle double quote state, but only if not escaped
          if (i > 0 && sqlContent[i - 1] !== '\\') {
            inDoubleQuote = !inDoubleQuote;
          }
        }
      }

      // Handle semicolons - only split on semicolons outside of quotes and dollar quotes
      if (char === ';' && !inSingleQuote && !inDoubleQuote && !inDollarQuote && !inComment) {
        // Add the current statement (without the semicolon) to the list
        if (currentStatement.trim().length > 0) {
          statements.push(currentStatement.trim());
        }
        currentStatement = '';
      } else {
        currentStatement += char;
      }
    }

    // Add the last statement if there is one
    if (currentStatement.trim().length > 0) {
      statements.push(currentStatement.trim());
    }

    // Execute each statement
    let successCount = 0;
    let errorCount = 0;
    let insertSuccessCount = 0;
    let deleteSuccessCount = 0;
    let truncateSuccessCount = 0;
    let updateSuccessCount = 0;
    let createSuccessCount = 0;
    let dropSuccessCount = 0;
    let alterSuccessCount = 0;
    let otherSuccessCount = 0;

    for (let i = 0; i < statements.length; i++) {
      // Add semicolon back to the statement if it doesn't already end with one
      let stmt = statements[i].trim();
      if (!stmt.endsWith(';')) {
        stmt += ';';
      }

      // Skip empty statements and comments-only statements
      if (stmt.length <= 1 || stmt.trim().startsWith('--')) continue;

      try {
        // Handle special cases for better compatibility

        // Handle SET statements which might not be supported in transactions
        if (stmt.toUpperCase().startsWith('SET ') && !stmt.toUpperCase().includes('LOCAL')) {
          console.log(`${colors.yellow}Skipping non-transactional SET statement: ${stmt.substring(0, 50)}...${colors.reset}`);
          continue;
        }

        // Handle sequence reset statements
        if (stmt.toUpperCase().includes('SETVAL')) {
          try {
            await client.query(stmt);
            successCount++;
            otherSuccessCount++;
            continue;
          } catch (seqErr) {
            console.log(`${colors.yellow}Warning: Sequence reset failed, will try again after data import: ${seqErr.message}${colors.reset}`);
            // Store for later execution after all other statements
            continue;
          }
        }

        // Execute the statement
        await client.query(stmt);
        successCount++;

        // Count by statement type (case insensitive matching)
        const upperStmt = stmt.toUpperCase();
        if (upperStmt.includes('INSERT INTO')) {
          insertSuccessCount++;
        } else if (upperStmt.includes('DELETE FROM')) {
          deleteSuccessCount++;
        } else if (upperStmt.includes('TRUNCATE TABLE')) {
          truncateSuccessCount++;
        } else if (upperStmt.includes('UPDATE ')) {
          updateSuccessCount++;
        } else if (upperStmt.includes('CREATE TABLE')) {
          createSuccessCount++;
        } else if (upperStmt.includes('DROP TABLE')) {
          dropSuccessCount++;
        } else if (upperStmt.includes('ALTER TABLE')) {
          alterSuccessCount++;
        } else {
          otherSuccessCount++;
        }

        if (successCount % 100 === 0) {
          process.stdout.write(`${colors.green}Processed ${successCount} statements\r${colors.reset}`);
        }
      } catch (err) {
        errorCount++;
        console.error(`${colors.red}Error executing statement ${i + 1}: ${err.message}${colors.reset}`);

        // Log the problematic statement for debugging
        const stmtPreview = stmt.length > 100 ? stmt.substring(0, 100) + '...' : stmt;
        console.error(`${colors.dim}Statement: ${stmtPreview}${colors.reset}`);

        // Ask whether to continue or rollback
        if (errorCount === 1) {
          const answer = await askQuestion(`${colors.yellow}Continue despite errors? (y/n): ${colors.reset}`);
          if (answer.toLowerCase() !== 'y' && answer.toLowerCase() !== 'yes') {
            console.log(`${colors.yellow}Rolling back transaction...${colors.reset}`);
            await client.query('ROLLBACK');
            console.log(`${colors.yellow}Import cancelled${colors.reset}`);
            process.exit(1);
          }
        }
      }
    }

    // Commit transaction
    await client.query('COMMIT');

    console.log(`\n${colors.green}Import completed: ${successCount} successful, ${errorCount} errors${colors.reset}`);

    // Show detailed success counts
    if (successCount > 0) {
      console.log(`${colors.green}Successful statements by type:${colors.reset}`);
      if (insertSuccessCount > 0) console.log(`${colors.green}- INSERT: ${insertSuccessCount}${colors.reset}`);
      if (deleteSuccessCount > 0) console.log(`${colors.green}- DELETE: ${deleteSuccessCount}${colors.reset}`);
      if (truncateSuccessCount > 0) console.log(`${colors.green}- TRUNCATE: ${truncateSuccessCount}${colors.reset}`);
      if (updateSuccessCount > 0) console.log(`${colors.green}- UPDATE: ${updateSuccessCount}${colors.reset}`);
      if (createSuccessCount > 0) console.log(`${colors.green}- CREATE TABLE: ${createSuccessCount}${colors.reset}`);
      if (dropSuccessCount > 0) console.log(`${colors.green}- DROP TABLE: ${dropSuccessCount}${colors.reset}`);
      if (alterSuccessCount > 0) console.log(`${colors.green}- ALTER TABLE: ${alterSuccessCount}${colors.reset}`);
      if (otherSuccessCount > 0) console.log(`${colors.green}- Other: ${otherSuccessCount}${colors.reset}`);
    }

  } catch (err) {
    console.error(`${colors.red}Error: ${err.message}${colors.reset}`);

    // Check if it's a connection error
    if (err.code === 'ECONNREFUSED' || err.code === '28P01' || err.code === '3D000' || err.message.includes('connect')) {
      console.error(`${colors.yellow}Database connection error. Please check your connection settings.${colors.reset}`);
      console.error(`${colors.yellow}To set the connection string, use the SUPABASE_CONNECTION_STRING environment variable:${colors.reset}`);
      console.error(`${colors.yellow}export SUPABASE_CONNECTION_STRING='postgresql://postgres:password@your-supabase-host:5432/postgres'${colors.reset}`);
      console.error(`${colors.yellow}Make sure your database is running and accessible.${colors.reset}`);
    } else {
      // Rollback transaction if client exists
      if (client) {
        try {
          await client.query('ROLLBACK');
          console.log(`${colors.yellow}Transaction rolled back${colors.reset}`);
        } catch (rollbackErr) {
          console.error(`${colors.red}Error rolling back transaction: ${rollbackErr.message}${colors.reset}`);
        }
      }
    }

    process.exit(1);
  } finally {
    if (client) {
      client.release();
    }

    await pool.end();
  }
}

/**
 * Dump Supabase database to SQL file
 * @param {string} outputFile - Output file path (optional)
 * @param {Object} options - Additional options
 * @param {boolean} options.schemaOnly - Whether to dump only the schema without data
 * @param {string} options.table - Specific table to dump (if not provided, dumps all tables)
 */
async function dumpDatabase(outputFile, options = {}) {
  // Generate default output filename if not provided
  if (!outputFile) {
    const timestamp = new Date().toISOString().replace(/[:.]/g, '-').replace('T', '_').split('Z')[0];
    let filePrefix = options.schemaOnly ? 'supabase_schema_' : 'supabase_dump_';

    // If dumping a specific table, include the table name in the filename
    if (options.table) {
      filePrefix = options.table + '_' + filePrefix;
    }

    outputFile = `${filePrefix}${timestamp}.sql`;
  }

  let client = null;
  // Array to collect all foreign key constraints
  let foreignKeys = [];

  try {
    // Connect to the database
    client = await pool.connect();
    console.log(`${colors.green}Connected to Supabase database${colors.reset}`);

    // Get tables to process
    let tables = [];

    if (options.table) {
      // Check if the specified table exists
      const tableExistsResult = await client.query(`
        SELECT EXISTS (
          SELECT 1
          FROM information_schema.tables
          WHERE table_schema = 'public'
          AND table_name = $1
        ) AS exists
      `, [options.table]);

      if (!tableExistsResult.rows[0].exists) {
        console.error(`${colors.red}Error: Table '${options.table}' does not exist${colors.reset}`);
        process.exit(1);
      }

      tables = [options.table];
      console.log(`${colors.blue}Dumping single table: ${options.table}${colors.reset}`);
    } else {
      // Get all user tables (excluding system tables)
      const tablesResult = await client.query(`
        SELECT table_name
        FROM information_schema.tables
        WHERE table_schema = 'public'
        AND table_type = 'BASE TABLE'
        ORDER BY table_name
      `);

      const allTables = tablesResult.rows.map(row => row.table_name);
      console.log(`${colors.blue}Found ${allTables.length} tables: ${allTables.join(', ')}${colors.reset}`);

      // Get foreign key dependencies to determine the correct order
      console.log(`${colors.blue}Analyzing table dependencies for proper ordering...${colors.reset}`);

      try {
        // Get all foreign key relationships
        const fkResult = await client.query(`
          SELECT
            tc.table_name,
            ccu.table_name AS referenced_table
          FROM
            information_schema.table_constraints AS tc
            JOIN information_schema.key_column_usage AS kcu
              ON tc.constraint_name = kcu.constraint_name
              AND tc.table_schema = kcu.table_schema
            JOIN information_schema.constraint_column_usage AS ccu
              ON ccu.constraint_name = tc.constraint_name
              AND ccu.table_schema = tc.table_schema
          WHERE tc.constraint_type = 'FOREIGN KEY'
          AND tc.table_schema = 'public'
        `);

        // Build dependency graph
        const dependencies = {};
        allTables.forEach(table => {
          dependencies[table] = [];
        });

        fkResult.rows.forEach(row => {
          if (row.table_name !== row.referenced_table) { // Avoid self-references
            dependencies[row.table_name].push(row.referenced_table);
          }
        });

        // Reverse the dependencies to get the correct order for creation
        // We want referenced tables to come before tables that reference them
        const reversedDependencies = {};
        allTables.forEach(table => {
          reversedDependencies[table] = [];
        });

        // Reverse the graph: if A depends on B, then B comes before A in our sort
        fkResult.rows.forEach(row => {
          if (row.table_name !== row.referenced_table) { // Avoid self-references
            // If table A references table B, then B should come before A
            if (reversedDependencies[row.referenced_table]) {
              reversedDependencies[row.referenced_table].push(row.table_name);
            }
          }
        });

        console.log(`${colors.blue}Building dependency graph for proper table ordering...${colors.reset}`);

        // Debug: Print the dependency graph
        Object.keys(reversedDependencies).forEach(table => {
          if (reversedDependencies[table].length > 0) {
            console.log(`${colors.dim}${table} is referenced by: ${reversedDependencies[table].join(', ')}${colors.reset}`);
          }
        });

        // Topological sort function to order tables based on dependencies
        function topologicalSort(graph) {
          const visited = {};
          const temp = {};
          const result = [];

          function visit(node) {
            if (temp[node]) {
              // Circular dependency detected, but we'll still proceed
              console.log(`${colors.yellow}Warning: Circular dependency detected involving table '${node}'${colors.reset}`);
              return;
            }

            if (!visited[node]) {
              temp[node] = true;

              // Visit tables that depend on this table first
              (graph[node] || []).forEach(dependent => {
                if (graph[dependent]) { // Only visit if it's a valid node
                  visit(dependent);
                }
              });

              visited[node] = true;
              temp[node] = false;
              result.push(node); // Add to the end of the result
            }
          }

          // Visit all nodes
          Object.keys(graph).forEach(node => {
            if (!visited[node]) {
              visit(node);
            }
          });

          return result;
        }

        // Sort tables based on dependencies
        tables = topologicalSort(reversedDependencies);

        // Make sure all tables are included (in case there are isolated tables)
        allTables.forEach(table => {
          if (!tables.includes(table)) {
            tables.push(table);
          }
        });

        console.log(`${colors.green}Tables ordered based on dependencies:${colors.reset}`);
        console.log(`${colors.blue}${tables.join(' → ')}${colors.reset}`);
      } catch (err) {
        console.error(`${colors.yellow}Warning: Could not determine table dependencies: ${err.message}${colors.reset}`);
        console.error(`${colors.yellow}Falling back to alphabetical order${colors.reset}`);
        tables = allTables;
      }
    }

    // Create the SQL file
    const writeStream = fs.createWriteStream(outputFile);

    // Write header
    writeStream.write('-- Supabase database dump\n');
    if (options.schemaOnly) {
      writeStream.write('-- Schema only (no data)\n');
    }
    if (options.table) {
      writeStream.write(`-- Table: ${options.table}\n`);
    }
    writeStream.write(`-- Generated on ${new Date().toISOString()}\n\n`);

    // Add option to disable foreign key constraints during import
    writeStream.write('-- Disable foreign key constraints during import (uncomment to use)\n');
    writeStream.write('-- SET session_replication_role = \'replica\';\n\n');

    // Add transaction start
    writeStream.write('-- Start transaction\n');
    writeStream.write('BEGIN;\n\n');

    // Process each table
    for (const tableName of tables) {
      console.log(`${colors.yellow}Processing table: ${tableName}${colors.reset}`);

      // Get the table structure with more detailed information
      const tableInfoResult = await client.query(`
        SELECT
          column_name,
          data_type,
          character_maximum_length,
          numeric_precision,
          numeric_scale,
          is_nullable,
          column_default,
          udt_name
        FROM information_schema.columns
        WHERE table_name = $1
        ORDER BY ordinal_position
      `, [tableName]);

      const columns = tableInfoResult.rows.map(row => row.column_name);

      // Write DROP TABLE statement
      writeStream.write(`-- Table: ${tableName}\n`);
      writeStream.write(`DROP TABLE IF EXISTS ${tableName} CASCADE;\n\n`);

      // Write CREATE TABLE statement
      writeStream.write(`CREATE TABLE ${tableName} (\n`);
      tableInfoResult.rows.forEach((col, index) => {
        let dataType = col.data_type;

        // Handle different data types properly
        if (col.data_type === 'character varying' && col.character_maximum_length) {
          dataType = `varchar(${col.character_maximum_length})`;
        } else if (col.data_type === 'character' && col.character_maximum_length) {
          dataType = `char(${col.character_maximum_length})`;
        } else if (col.data_type === 'numeric' && col.numeric_precision !== null && col.numeric_scale !== null) {
          dataType = `numeric(${col.numeric_precision}, ${col.numeric_scale})`;
        } else if (col.data_type === 'ARRAY') {
          // For array types, get the base type from udt_name
          const baseType = col.udt_name.replace(/^_/, '');
          dataType = `${baseType}[]`;
        } else if (col.data_type === 'USER-DEFINED') {
          // For custom types, use the UDT name
          dataType = col.udt_name;
        }

        const nullable = col.is_nullable === 'YES' ? '' : ' NOT NULL';

        // Handle default values properly
        let defaultVal = '';
        if (col.column_default) {
          // Check if it's a sequence for serial/identity columns
          if (col.column_default.includes('nextval')) {
            // For serial/identity columns, we'll handle the sequence separately
            defaultVal = '';
          } else {
            defaultVal = ` DEFAULT ${col.column_default}`;
          }
        }

        const comma = index < tableInfoResult.rows.length - 1 ? ',' : '';

        writeStream.write(`  ${col.column_name} ${dataType}${nullable}${defaultVal}${comma}\n`);
      });
      writeStream.write(');\n\n');

      // Get primary key info
      try {
        const pkResult = await client.query(`
          SELECT a.attname
          FROM pg_index i
          JOIN pg_attribute a ON a.attrelid = i.indrelid AND a.attnum = ANY(i.indkey)
          WHERE i.indrelid = $1::regclass
          AND i.indisprimary
        `, [tableName]);

        if (pkResult.rows.length > 0) {
          const pkColumns = pkResult.rows.map(row => row.attname);
          writeStream.write(`ALTER TABLE ${tableName} ADD PRIMARY KEY (${pkColumns.join(', ')});\n\n`);
        }
      } catch (err) {
        console.error(`${colors.red}Error getting primary key for ${tableName}: ${err.message}${colors.reset}`);
      }

      // Collect foreign key constraints to add them at the end of the file
      try {
        const fkResult = await client.query(`
          SELECT
            tc.constraint_name,
            tc.table_name,
            kcu.column_name,
            ccu.table_name AS foreign_table_name,
            ccu.column_name AS foreign_column_name
          FROM
            information_schema.table_constraints AS tc
            JOIN information_schema.key_column_usage AS kcu
              ON tc.constraint_name = kcu.constraint_name
              AND tc.table_schema = kcu.table_schema
            JOIN information_schema.constraint_column_usage AS ccu
              ON ccu.constraint_name = tc.constraint_name
              AND ccu.table_schema = tc.table_schema
          WHERE tc.constraint_type = 'FOREIGN KEY' AND tc.table_name = $1
        `, [tableName]);

        if (fkResult.rows.length > 0) {
          // Store foreign key constraints to add them at the end
          if (!foreignKeys) foreignKeys = [];

          fkResult.rows.forEach(fk => {
            foreignKeys.push({
              tableName: fk.table_name,
              constraintName: fk.constraint_name,
              columnName: fk.column_name,
              foreignTableName: fk.foreign_table_name,
              foreignColumnName: fk.foreign_column_name
            });
          });
        }
      } catch (err) {
        console.error(`${colors.red}Error getting foreign keys for ${tableName}: ${err.message}${colors.reset}`);
      }

      // Get sequence information for serial/identity columns
      try {
        const seqResult = await client.query(`
          SELECT
            pg_get_serial_sequence($1, a.attname) as sequence_name,
            a.attname as column_name
          FROM
            pg_attribute a
          WHERE
            a.attrelid = $1::regclass
            AND NOT a.attisdropped
            AND pg_get_serial_sequence($1, a.attname) IS NOT NULL
        `, [tableName]);

        if (seqResult.rows.length > 0) {
          writeStream.write(`-- Sequences for table: ${tableName}\n`);

          for (const seq of seqResult.rows) {
            if (seq.sequence_name) {
              // Get sequence details
              const seqDetailsResult = await client.query(`
                SELECT
                  sequence_name,
                  data_type,
                  start_value,
                  minimum_value,
                  maximum_value,
                  increment,
                  cycle_option
                FROM information_schema.sequences
                WHERE sequence_name = $1
              `, [seq.sequence_name.split('.')[1]]);

              if (seqDetailsResult.rows.length > 0) {
                const seqDetails = seqDetailsResult.rows[0];

                // Write CREATE SEQUENCE statement to ensure it exists
                writeStream.write(`-- Create sequence if it doesn't exist\n`);
                writeStream.write(`CREATE SEQUENCE IF NOT EXISTS ${seq.sequence_name}\n`);
                writeStream.write(`  INCREMENT ${seqDetails.increment}\n`);
                writeStream.write(`  MINVALUE ${seqDetails.minimum_value}\n`);
                writeStream.write(`  MAXVALUE ${seqDetails.maximum_value}\n`);
                writeStream.write(`  START ${seqDetails.start_value}\n`);
                writeStream.write(`  ${seqDetails.cycle_option === 'YES' ? 'CYCLE' : 'NO CYCLE'};\n\n`);

                // Get current value of sequence
                const currvalResult = await client.query(`SELECT last_value, is_called FROM ${seq.sequence_name}`);
                const lastValue = currvalResult.rows[0].last_value;
                const isCalled = currvalResult.rows[0].is_called;

                // Write sequence reset command
                writeStream.write(`-- Set sequence value\n`);
                writeStream.write(`SELECT pg_catalog.setval('${seq.sequence_name}', ${lastValue}, ${isCalled});\n\n`);

                // Write sequence ownership
                writeStream.write(`-- Set sequence ownership\n`);
                writeStream.write(`ALTER SEQUENCE ${seq.sequence_name} OWNED BY ${tableName}.${seq.column_name};\n`);
              }
            }
          }
          writeStream.write('\n');
        }
      } catch (err) {
        console.error(`${colors.red}Error getting sequence info for ${tableName}: ${err.message}${colors.reset}`);
        // Write a comment about the error
        writeStream.write(`-- Error getting sequence info for ${tableName}: ${err.message}\n`);
        writeStream.write(`-- You may need to manually create and set sequences for this table\n\n`);
      }

      // Get all data from the table (skip if schema-only)
      if (!options.schemaOnly) {
        try {
          const dataResult = await client.query(`SELECT * FROM ${tableName}`);
          console.log(`${colors.blue}Found ${dataResult.rows.length} rows in ${tableName}${colors.reset}`);

          // Write INSERT statements
          if (dataResult.rows.length > 0) {
            writeStream.write(`-- Data for table: ${tableName}\n`);

            // Get column types for proper formatting
            const columnTypes = {};
            tableInfoResult.rows.forEach(col => {
              columnTypes[col.column_name] = {
                dataType: col.data_type,
                udtName: col.udt_name
              };
            });

            dataResult.rows.forEach(row => {
              const values = columns.map(col => {
                const value = row[col];
                const colType = columnTypes[col] || { dataType: 'unknown' };

                if (value === null) return 'NULL';

                // Handle different data types
                if (typeof value === 'string') {
                  return `'${value.replace(/'/g, "''")}'`;
                }

                if (typeof value === 'object' && value instanceof Date) {
                  return `'${value.toISOString()}'`;
                }

                if (typeof value === 'object') {
                  // Handle arrays
                  if (Array.isArray(value)) {
                    // Format array according to PostgreSQL syntax
                    const arrayStr = JSON.stringify(value)
                      .replace('[', '{')
                      .replace(']', '}')
                      .replace(/"/g, "'");
                    return arrayStr;
                  }

                  // Handle JSON and JSONB
                  if (colType.dataType === 'json' || colType.dataType === 'jsonb') {
                    return `'${JSON.stringify(value).replace(/'/g, "''")}'::${colType.dataType}`;
                  }

                  // Handle other objects
                  return `'${JSON.stringify(value).replace(/'/g, "''")}'`;
                }

                // Handle boolean values
                if (typeof value === 'boolean') {
                  return value ? 'TRUE' : 'FALSE';
                }

                // Handle numeric values
                if (typeof value === 'number') {
                  return value;
                }

                // Default case
                return `'${String(value).replace(/'/g, "''")}'`;
              });

              writeStream.write(`INSERT INTO ${tableName} (${columns.join(', ')}) VALUES (${values.join(', ')});\n`);
            });

            writeStream.write('\n');
          }
        } catch (err) {
          console.error(`${colors.red}Error getting data from ${tableName}: ${err.message}${colors.reset}`);
          writeStream.write(`-- Error getting data from ${tableName}: ${err.message}\n\n`);
        }
      } else {
        console.log(`${colors.blue}Skipping data for ${tableName} (schema-only mode)${colors.reset}`);
      }
    }

    // Write all foreign key constraints at the end
    if (foreignKeys && foreignKeys.length > 0) {
      writeStream.write('-- Foreign key constraints (added at the end to avoid dependency issues)\n');

      // Group foreign keys by table for better organization
      const fkByTable = {};
      foreignKeys.forEach(fk => {
        if (!fkByTable[fk.tableName]) {
          fkByTable[fk.tableName] = [];
        }
        fkByTable[fk.tableName].push(fk);
      });

      // Write foreign key constraints for each table
      Object.keys(fkByTable).forEach(tableName => {
        writeStream.write(`-- Foreign key constraints for table: ${tableName}\n`);
        fkByTable[tableName].forEach(fk => {
          writeStream.write(`ALTER TABLE ${fk.tableName} ADD CONSTRAINT ${fk.constraintName} FOREIGN KEY (${fk.columnName}) REFERENCES ${fk.foreignTableName} (${fk.foreignColumnName});\n`);
        });
        writeStream.write('\n');
      });
    }

    // Add transaction end and re-enable foreign key constraints
    writeStream.write('-- Commit transaction\n');
    writeStream.write('COMMIT;\n\n');

    // Add option to re-enable foreign key constraints
    writeStream.write('-- Re-enable foreign key constraints (uncomment if you disabled them above)\n');
    writeStream.write('-- SET session_replication_role = \'origin\';\n\n');

    // Close the file
    writeStream.end();

    // Wait for the stream to finish before calculating file size
    await new Promise((resolve) => {
      writeStream.on('finish', resolve);
    });

    // Get file size
    const stats = fs.statSync(outputFile);
    const fileSizeInBytes = stats.size;

    // Format file size in appropriate units
    let fileSizeStr;
    if (fileSizeInBytes < 1024) {
      fileSizeStr = `${fileSizeInBytes} bytes`;
    } else if (fileSizeInBytes < 1024 * 1024) {
      fileSizeStr = `${(fileSizeInBytes / 1024).toFixed(2)} KB`;
    } else {
      fileSizeStr = `${(fileSizeInBytes / (1024 * 1024)).toFixed(2)} MB`;
    }

    console.log(`${colors.green}Dump completed successfully!${colors.reset}`);
    console.log(`${colors.green}File saved as: ${outputFile} (${fileSizeStr})${colors.reset}`);

  } catch (err) {
    console.error(`${colors.red}Error: ${err.message}${colors.reset}`);

    // Check if it's a connection error
    if (err.code === 'ECONNREFUSED' || err.code === '28P01' || err.code === '3D000' || err.message.includes('connect')) {
      console.error(`${colors.yellow}Database connection error. Please check your connection settings.${colors.reset}`);
      console.error(`${colors.yellow}To set the connection string, use the SUPABASE_CONNECTION_STRING environment variable:${colors.reset}`);
      console.error(`${colors.yellow}export SUPABASE_CONNECTION_STRING='postgresql://postgres:password@your-supabase-host:5432/postgres'${colors.reset}`);
      console.error(`${colors.yellow}Make sure your database is running and accessible.${colors.reset}`);
    }

    process.exit(1);
  } finally {
    if (client) {
      client.release();
    }

    await pool.end();
  }
}

/**
 * Ask a question and get user input
 * @param {string} question - Question to ask
 * @returns {Promise<string>} - User's answer
 */
function askQuestion(question) {
  const rl = readline.createInterface({
    input: process.stdin,
    output: process.stdout
  });

  return new Promise(resolve => {
    rl.question(question, answer => {
      rl.close();
      resolve(answer);
    });
  });
}

/**
 * Mask sensitive parts of a connection string
 * @param {string} connString - The connection string to mask
 * @returns {string} - The masked connection string
 */
function maskConnectionString(connString) {
  if (!connString) return '';

  try {
    // Parse the connection string
    // Format: postgresql://username:password@host:port/database
    const regex = /^(postgresql:\/\/)([^:]+):([^@]+)@([^:]+):(\d+)\/(.+)$/;
    const match = connString.match(regex);

    if (!match) return connString; // Return original if format doesn't match

    const protocol = match[1];
    const username = match[2];
    const password = match[3];
    const host = match[4];
    const port = match[5];
    const database = match[6];

    // Mask the password (show only first and last character)
    let maskedPassword;
    if (password.length <= 4) {
      maskedPassword = '*'.repeat(password.length);
    } else {
      maskedPassword = password.charAt(0) + '*'.repeat(password.length - 2) + password.charAt(password.length - 1);
    }

    // Mask only about 30% of the host
    let maskedHost;
    if (host.includes('.')) {
      const parts = host.split('.');
      if (parts.length >= 3) {
        // For hosts like db.example.com
        // Mask only a small portion of the middle part
        const middlePart = parts[1];
        const maskLength = Math.ceil(middlePart.length * 0.3); // Mask 30% of the middle part
        const startPos = Math.floor((middlePart.length - maskLength) / 2);
        const maskedMiddle = middlePart.substring(0, startPos) +
                            '*'.repeat(maskLength) +
                            middlePart.substring(startPos + maskLength);
        maskedHost = parts[0] + '.' + maskedMiddle + '.' + parts[parts.length - 1];
      } else if (parts.length === 2) {
        // For hosts like example.com
        // Mask only a small portion of the first part
        const firstPart = parts[0];
        const maskLength = Math.ceil(firstPart.length * 0.3); // Mask 30% of the first part
        const startPos = Math.floor((firstPart.length - maskLength) / 2);
        const maskedFirst = firstPart.substring(0, startPos) +
                           '*'.repeat(maskLength) +
                           firstPart.substring(startPos + maskLength);
        maskedHost = maskedFirst + '.' + parts[1];
      } else {
        maskedHost = host;
      }
    } else {
      // For IP addresses or simple hostnames, mask only 30% in the middle
      if (host.length <= 4) {
        maskedHost = host;
      } else {
        const maskLength = Math.ceil(host.length * 0.3); // Mask 30% of the host
        const startPos = Math.floor((host.length - maskLength) / 2);
        maskedHost = host.substring(0, startPos) +
                    '*'.repeat(maskLength) +
                    host.substring(startPos + maskLength);
      }
    }

    // Reconstruct the masked connection string
    return `${protocol}${username}:${maskedPassword}@${maskedHost}:${port}/${database}`;
  } catch (err) {
    // If any error occurs during masking, return the original string
    return connString;
  }
}

